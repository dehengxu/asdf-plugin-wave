#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"

asset="$(pick_asset "$ASDF_INSTALL_VERSION")" ||
  fail "no downloadable build for $(host_os)/$(host_arch) at v${ASDF_INSTALL_VERSION}"

download_release "$ASDF_INSTALL_VERSION" "$asset" "$ASDF_DOWNLOAD_PATH/$asset"
